---
import LeftSidebar from "./LeftSidebar.astro";
import TableOfContents from "./TableOfContents.astro";
import RecentPosts from "./RecentPosts.astro";
import MobileMenuToggle from "./MobileMenuToggle.astro";

type Props = {
  headings?: { depth: number; slug: string; text: string }[];
  showToc?: boolean;
};

const { headings = [], showToc = true } = Astro.props;

// Always show TOC if there are valid headings (depth 2-4)
const hasToc = headings.some(h => h.depth >= 2 && h.depth <= 4);
---

<MobileMenuToggle />

<div class="blog-shell">
  <!-- Left sidebar: Navigation & content -->
  <aside class="blog-rail blog-rail-left" id="mobile-menu">
    <LeftSidebar />
  </aside>

  <!-- Main content -->
  <div class="blog-col-main">
    <slot />
  </div>

  <!-- Right sidebar: Table of contents or Recent Posts -->
  <aside class="blog-rail blog-rail-right">
    {
      hasToc ? (
        <TableOfContents headings={headings} />
      ) : (
        <RecentPosts />
      )
    }
  </aside>
</div>

<style>
  .blog-shell {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    width: 100%;
    min-height: calc(100vh - 200px);
  }

  .blog-rail {
    padding: 1.5rem;
  }

  .blog-col-main {
    min-width: 0;
  }

  /* Tablet & Desktop: 2-column layout */
  @media (width >= 768px) {
    .blog-shell {
      grid-template-columns: 16rem 1fr;
    }

    .blog-rail-left {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
      padding: 1.5rem;
      padding-right: 1rem;
      border-right: 1px solid var(--color-border);
    }
  }

  /* Wide Desktop: 3-column layout */
  @media (width >= 1280px) {
    .blog-shell {
      grid-template-columns: 16rem 1fr 15rem;
    }

    .blog-rail-right {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
      padding: 1.5rem;
      padding-left: 1rem;
      border-left: 1px solid var(--color-border);
      font-size: 0.875rem;
    }
  }

  /* Mobile: hide sidebars */
  @media (width < 768px) {
    .blog-rail-left,
    .blog-rail-right {
      display: none;
    }

    .blog-rail-left.mobile-open {
      display: flex;
      position: fixed;
      inset: 0;
      z-index: 30;
      width: 100%;
      flex-direction: column;
      max-width: none;
      height: 100vh;
      padding-top: 5rem;
      background-color: var(--background);
      border: none;
      overflow-y: auto;
    }
  }

  /* Mobile-medium: hide right sidebar only */
  @media (width >= 768px) and (width < 1280px) {
    .blog-rail-right {
      display: none;
    }
  }
</style>
