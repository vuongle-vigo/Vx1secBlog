---
---

<button
  id="mobile-menu-toggle"
  class="mobile-menu-toggle"
  aria-label="Toggle navigation menu"
  aria-expanded="false"
  aria-controls="mobile-menu"
>
  <span class="hamburger">
    <span class="line"></span>
    <span class="line"></span>
    <span class="line"></span>
  </span>
</button>

<div id="mobile-menu-backdrop" class="mobile-menu-backdrop"></div>

<style>
  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    gap: 0.375rem;
    background: var(--color-accent);
    border: none;
    padding: 0.5rem;
    cursor: pointer;
    position: fixed;
    top: 1.5rem;
    left: 1.5rem;
    z-index: 40;
    border-radius: 0.375rem;
    transition: all 0.2s ease;
  }

  .mobile-menu-toggle:hover {
    opacity: 0.9;
    box-shadow: 0 2px 8px rgba(var(--rgb-accent), 0.3);
  }

  @media (width < 768px) {
    .mobile-menu-toggle {
      display: flex;
    }
  }

  .hamburger {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    width: 1.5rem;
    height: 1.5rem;
  }

  .line {
    width: 100%;
    height: 2.5px;
    background-color: var(--background);
    border-radius: 1px;
    transition: all 0.3s ease;
  }

  .mobile-menu-toggle[aria-expanded="true"] .line:nth-child(1) {
    transform: rotate(45deg) translate(0.5rem, 0.5rem);
  }

  .mobile-menu-toggle[aria-expanded="true"] .line:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-toggle[aria-expanded="true"] .line:nth-child(3) {
    transform: rotate(-45deg) translate(0.5rem, -0.5rem);
  }

  .mobile-menu-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 20;
  }

  .mobile-menu-backdrop.active {
    display: block;
  }
</style>

<script>
  function initMobileMenu() {
    const toggle = document.getElementById("mobile-menu-toggle");
    const backdrop = document.getElementById("mobile-menu-backdrop");
    const leftRail = document.querySelector(".blog-rail-left");

    if (!toggle || !backdrop || !leftRail) return;

    let isOpen = false;

    function toggleMenu() {
      isOpen = !isOpen;
      toggle.setAttribute("aria-expanded", isOpen.toString());
      backdrop.classList.toggle("active", isOpen);
      leftRail.classList.toggle("mobile-open", isOpen);
    }

    toggle.addEventListener("click", toggleMenu);
    backdrop.addEventListener("click", () => {
      if (isOpen) toggleMenu();
    });

    // Close menu when clicking a link
    leftRail.addEventListener("click", (e) => {
      if (e.target.tagName === "A" && isOpen) {
        toggleMenu();
      }
    });
  }

  // Initialize on page load
  document.addEventListener("astro:page-load", initMobileMenu);
  initMobileMenu();
</script>
