---
type Props = {
  headings: { depth: number; slug: string; text: string }[];
};

const { headings } = Astro.props;

// Filter headings to only include h2-h4
const toc = headings.filter(h => h.depth >= 2 && h.depth <= 4);
---

<div class="toc-container">
  <div class="toc-header">📑 On This Page</div>
  {
    toc.length > 0 ? (
      <ul class="toc-list">
        {toc.map(heading => (
          <li
            class:list={[
              "toc-item",
              {
                "toc-h2": heading.depth === 2,
                "toc-h3": heading.depth === 3,
                "toc-h4": heading.depth === 4,
              },
            ]}
          >
            <a href={`#${heading.slug}`} class="toc-link">
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-xs opacity-60">No headings found</p>
    )
  }
</div>

<style>
  .toc-container {
    padding: 1.5rem 0;
  }

  .toc-header {
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 1rem;
    opacity: 0.8;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .toc-item {
    margin: 0;
  }

  .toc-h2 {
    margin-left: 0;
  }

  .toc-h3 {
    margin-left: 1rem;
  }

  .toc-h4 {
    margin-left: 2rem;
  }

  .toc-link {
    display: block;
    padding: 0.25rem 0;
    font-size: 0.875rem;
    color: inherit;
    text-decoration: none;
    transition: all 0.2s ease;
    border-left: 2px solid transparent;
    padding-left: 0.5rem;
  }

  .toc-link:hover {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
  }

  .toc-item:has(.toc-link:target),
  .toc-link:target {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
  }
</style>
