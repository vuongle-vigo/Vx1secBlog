---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import BlogLayout from "@/components/BlogLayout.astro";
import Tag from "@/components/Tag.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { useTranslations } from "@/i18n";
import config from "@/config";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const tags = getUniqueTags(posts);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.tagsTitle} | ${config.site.title}`}>
  <BlogLayout headings={[]} showToc={false}>
    <main id="main-content" class="tags-content" data-pagefind-body>
      <h1 class="page-title">{t.pages.tagsTitle}</h1>
      <p class="page-desc">{t.pages.tagsDesc}</p>

      <div class="tags-grid">
        {tags.map(({ tag, tagName }) => <Tag {tag} {tagName} />)}
      </div>
    </main>
  </BlogLayout>

</Layout>

<style>
  .tags-content {
    max-width: 56rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    width: 100%;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--color-accent);
  }

  .page-desc {
    opacity: 0.7;
    margin-bottom: 2rem;
    font-style: italic;
  }

  .tags-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>
