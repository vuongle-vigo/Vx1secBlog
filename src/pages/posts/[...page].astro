---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import BlogLayout from "@/components/BlogLayout.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return paginate(getSortedPosts(posts), { pageSize: config.posts.perPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.postsTitle} | ${config.site.title}`}>
  <BlogLayout headings={[]} showToc={false}>
    <main id="main-content" class="posts-list-content" data-pagefind-body>
      <h1 class="page-title">{t.pages.postsTitle}</h1>
      <p class="page-desc">{t.pages.postsDesc}</p>

      <div class="posts-grid">
        {page.data.map(data => <Card {...data} />)}
      </div>

      <Pagination {page} />
    </main>
  </BlogLayout>

</Layout>

<style>
  .posts-list-content {
    max-width: 56rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    width: 100%;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--color-accent);
  }

  .page-desc {
    opacity: 0.7;
    margin-bottom: 2rem;
    font-style: italic;
  }

  .posts-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
